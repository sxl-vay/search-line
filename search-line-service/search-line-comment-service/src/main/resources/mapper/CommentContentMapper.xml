<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.boking.comment.domain.repository.CommentContentMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="top.boking.comment.domain.model.CommentContent">
        <id column="id" property="id"/>
        <result column="comment_index_id" property="commentIndexId"/>
        <result column="content" property="content"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id
        , comment_index_id, content, gmt_create, gmt_modified
    </sql>

    <!-- 根据评论索引ID查询评论内容 -->
    <select id="selectByCommentIndexId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM comment_content
        WHERE comment_index_id = #{commentIndexId}
    </select>

    <!-- 批量查询评论内容 -->
    <select id="selectByCommentIndexIds" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM comment_content
        WHERE comment_index_id IN
        <foreach collection="commentIndexIds" item="commentIndexId" open="(" separator="," close=")">
            #{commentIndexId}
        </foreach>
    </select>
</mapper>