<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.boking.comment.mapper.UserLikeMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="top.boking.comment.entity.UserLike">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="comment_id" property="commentId"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id
        , user_id, comment_id, gmt_create, gmt_modified
    </sql>

    <!-- 查询用户是否点赞过评论 -->
    <select id="selectByUserIdAndCommentId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user_like
        WHERE user_id = #{userId}
        AND comment_id = #{commentId}
    </select>

    <!-- 批量查询用户点赞记录 -->
    <select id="selectByUserIdAndCommentIds" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user_like
        WHERE user_id = #{userId}
        AND comment_id IN
        <foreach collection="commentIds" item="commentId" open="(" separator="," close=")">
            #{commentId}
        </foreach>
    </select>
</mapper>